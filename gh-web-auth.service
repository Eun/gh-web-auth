[Unit]
Description=GitHub CLI Web Authentication Daemon
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/gh-web-auth
Restart=on-failure
RestartSec=5
Environment=BROWSER=false
# Configure via environment variables, e.g.:
# Environment=GH_WEB_AUTH_LISTEN_ADDR=0.0.0.0:8080
# Environment=GH_CONFIG_DIR=/home/user/.config/gh
# Environment=GH_HOST=github.com
# Environment=GH_CLIENT_ID=your-client-id
# Environment=GH_CLIENT_SECRET=your-client-secret
# Environment=GH_SCOPES=repo,read:org,gist,workflow
# Environment=GH_GIT_PROTOCOL=https
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
